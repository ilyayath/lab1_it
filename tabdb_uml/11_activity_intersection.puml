@startuml 11_activity_intersection
' ============================================================
' Діаграма активності з доріжками: UC-10 «Виконати перетин
' таблиць». Складність обчислення O(|A| + |B|) завдяки
' хеш-множині ключів рядків таблиці B.
' ============================================================
skinparam shadowing false

|Користувач|
start
:Обрати команду «Перетин таблиць»;
|Система|
:Відобразити форму зі списком таблиць поточної бази;
repeat
  |Користувач|
  :Обрати таблиці A і B,
  ввести назву результату,
  за потреби позначити «зберегти в базі»;
  |Система|
  :Перевірити введені дані
  (назва непорожня, при збереженні унікальна);
  :Отримати таблиці A і B з бази
  та перевірити сумісність їхніх схем;
  backward:Показати повідомлення про помилку;
repeat while (Дані некоректні або схеми несумісні?) is (так) not (ні)
:Створити порожню таблицю-результат зі схемою A;
:Побудувати множину K_B ключів рядків таблиці B;
:Створити порожню множину S доданих ключів;
while (У таблиці A є необроблені рядки?) is (так)
  :Взяти наступний рядок r з A
  та обчислити k = key(r);
  if (k є в K_B і k немає в S?) then (так)
    :Додати копію r до результату
    та додати k до S;
  else (ні)
  endif
endwhile (ні)
if (Позначено «зберегти в базі»?) then (так)
  :Додати таблицю-результат до бази;
  :Позначити базу як змінену;
else (ні)
endif
:Відобразити таблицю-результат;
|Користувач|
:Переглянути результат;
stop
@enduml
